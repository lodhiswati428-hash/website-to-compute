import React, { useState } from "react";

export default function App() { const [questions, setQuestions] = useState([]); const [currentQuestion, setCurrentQuestion] = useState(null); const [quizMode, setQuizMode] = useState(false); const [score, setScore] = useState(0); const [index, setIndex] = useState(0); const [showResult, setShowResult] = useState(false);

// Add a new question const addQuestion = (e) => { e.preventDefault(); const form = e.target; const newQuestion = { question: form.question.value, options: [ form.option1.value, form.option2.value, form.option3.value, form.option4.value, ], answer: form.answer.value, }; setQuestions([...questions, newQuestion]); form.reset(); alert("Question added!"); };

// Start quiz const startQuiz = () => { if (questions.length === 0) { alert("No questions added yet!"); return; } setQuizMode(true); setIndex(0); setScore(0); setCurrentQuestion(questions[0]); setShowResult(false); };

// Submit answer const submitAnswer = (option) => { if (option === currentQuestion.answer) { setScore(score + 1); } if (index + 1 < questions.length) { setIndex(index + 1); setCurrentQuestion(questions[index + 1]); } else { setShowResult(true); } };

return ( <div className="p-6 max-w-2xl mx-auto"> <h1 className="text-2xl font-bold text-center mb-4">NEET Prep Quiz</h1>

{!quizMode && (
    <>
      <form onSubmit={addQuestion} className="space-y-3 p-4 border rounded-lg mb-6">
        <h2 className="font-semibold">Add Question</h2>
        <input name="question" placeholder="Enter question" required className="w-full border p-2 rounded" />
        <input name="option1" placeholder="Option 1" required className="w-full border p-2 rounded" />
        <input name="option2" placeholder="Option 2" required className="w-full border p-2 rounded" />
        <input name="option3" placeholder="Option 3" required className="w-full border p-2 rounded" />
        <input name="option4" placeholder="Option 4" required className="w-full border p-2 rounded" />
        <input name="answer" placeholder="Correct Answer (must match option)" required className="w-full border p-2 rounded" />
        <button type="submit" className="bg-blue-600 text-white px-4 py-2 rounded">Add</button>
      </form>

      <button onClick={startQuiz} className="bg-green-600 text-white px-4 py-2 rounded">Start Quiz</button>
    </>
  )}

  {quizMode && currentQuestion && !showResult && (
    <div className="space-y-4">
      <h2 className="text-lg font-semibold">Q{index + 1}. {currentQuestion.question}</h2>
      <div className="grid gap-2">
        {currentQuestion.options.map((opt, i) => (
          <button
            key={i}
            onClick={() => submitAnswer(opt)}
            className="border p-2 rounded hover:bg-gray-200"
          >
            {opt}
          </button>
        ))}
      </div>
    </div>
  )}

  {showResult && (
    <div className="text-center mt-6">
      <h2 className="text-xl font-bold">Quiz Finished!</h2>
      <p>Your Score: {score} / {questions.length}</p>
      <button onClick={() => setQuizMode(false)} className="mt-4 bg-blue-600 text-white px-4 py-2 rounded">Back to Home</button>
    </div>
  )}
</div>

); }

